<?xml version="1.0"?>
<!--
  gantry.urdf

  Overhead bridge-crane robot, not a free-floating XYZ stage. The whole
  point of this redesign: the robot's X/Y travel happens UP AT the
  overhead rail height (where it's physically supported by the farm's
  horizontal interconnecting poles), and reaching a specific trough is
  done by a hoist arm that telescopes DOWN from the trolley -- never by
  the robot's own base drifting through open space with nothing under
  it.

  Kinematic chain:
    base_link     -- fixed anchor, mounted at the overhead rail height
    carriage_link -- slides along X (the rail running along a row)
    row_link      -- slides along Y (between-aisle travel, and the
                     front/back face switch at a pole -- one axis
                     covers both, same as before)
    mast_link     -- FIXED short drop from the trolley -- a rigid
                     stub, not part of the robot's motion, that visually
                     grounds the trolley to something hanging below the
                     rail rather than the hoist appearing to sprout
                     from thin air
    hoist_link    -- slides DOWN (Z, but the joint's positive direction
                     points down) from the bottom of the mast to reach
                     each layer's height -- this is the "descends to
                     the pod" motion, replacing the old ground-anchored
                     vertical lift
    camera_link   -- small fixed marker at the tip of the hoist

  Joint limits are generous and the actual per-pod targets are supplied
  at runtime from gantry_robot.py (which also computes the rail height
  and mast length from the farm's dimensions), so this file doesn't
  need to change if the farm layout changes.
-->
<robot name="pod_farm_gantry">

  <material name="carriage_orange">
    <color rgba="0.90 0.55 0.10 1"/>
  </material>
  <material name="row_teal">
    <color rgba="0.10 0.55 0.55 1"/>
  </material>
  <material name="mast_grey">
    <color rgba="0.55 0.55 0.58 1"/>
  </material>
  <material name="hoist_blue">
    <color rgba="0.15 0.45 0.75 1"/>
  </material>
  <material name="camera_dark">
    <color rgba="0.05 0.05 0.05 1"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.12 0.05"/>
      </geometry>
      <material name="mast_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.12 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

  <link name="carriage_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.16 0.07"/>
      </geometry>
      <material name="carriage_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.16 0.07"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.006"/>
    </inertial>
  </link>

  <joint name="carriage_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="carriage_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.0" upper="4.0" effort="250" velocity="0.6"/>
    <dynamics damping="5.0" friction="1.0"/>
  </joint>

  <link name="row_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.14 0.06"/>
      </geometry>
      <material name="row_teal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.14 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004"/>
    </inertial>
  </link>

  <joint name="row_joint" type="prismatic">
    <parent link="carriage_link"/>
    <child link="row_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="8.0" effort="250" velocity="0.6"/>
    <dynamics damping="5.0" friction="1.0"/>
  </joint>

  <!-- fixed rigid stub hanging from the trolley -- purely visual
       continuity, not a controlled joint, so the hoist visibly starts
       from something attached to the trolley rather than in mid-air -->
  <link name="mast_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.35"/>
      </geometry>
      <material name="mast_grey"/>
    </visual>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="mast_fixed_joint" type="fixed">
    <parent link="row_link"/>
    <child link="mast_link"/>
    <origin xyz="0 0 -0.175" rpy="0 0 0"/>
  </joint>

  <!-- hoist_link is now just a small mounting stub -- the long visible
       reach between the mast and the camera is handled by a separately
       managed, dynamically-sized rod (see gantry_robot.py
       _sync_hoist_visual), redrawn to exactly close the gap after every
       move. A fixed-length link here couldn't do that: for any
       extension beyond half its own length it would leave a visible
       gap, and every layer in this farm needs 4-15x that much. -->
  <link name="hoist_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.05"/>
      </geometry>
      <material name="hoist_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <!-- axis points DOWN: increasing joint value extends the hoist
       further below the mast, i.e. descends toward a lower trough
       layer. Zero = hoist tucked right against the bottom of the mast. -->
  <joint name="hoist_joint" type="prismatic">
    <parent link="mast_link"/>
    <child link="hoist_link"/>
    <origin xyz="0 0 -0.175" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0.0" upper="2.5" effort="200" velocity="0.6"/>
    <dynamics damping="5.0" friction="1.0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.06"/>
      </geometry>
      <material name="camera_dark"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="hoist_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 -0.05" rpy="1.5708 0 0"/>
  </joint>

</robot>
